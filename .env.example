# YouTube Shorts Agent — Environment Variables
# Copy to .env and fill in your values
# NOTE: No Anthropic API key needed! Claude runs via Agent SDK (Claude Code subscription)

# AWS credentials (Polly TTS + Secrets Manager)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# AWS Polly Neural voice — options: Matthew, Joanna, Amy, Brian, Aria
POLLY_VOICE=Matthew

# Pexels free B-roll footage — get key at pexels.com/api
PEXELS_API_KEY=...

# AWS Secrets Manager key where YouTube OAuth token is stored
YOUTUBE_SECRET_NAME=youtube-shorts-agent/oauth-token

# Default niche: psychology | whatif
DEFAULT_NICHE=psychology
